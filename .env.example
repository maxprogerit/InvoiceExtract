# Copy to .env and adjust. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Shared secret the clients must send in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Used by the app when it runs on the host (uvicorn / alembic from your venv).
# Inside docker compose the api service overrides the host with "db".
DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5433/invoiceextract

# Used by docker-compose to create the Postgres container.
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice
POSTGRES_DB=invoiceextract
POSTGRES_PORT=5433

# Upload limits
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5

# OCR (Tesseract). Languages joined with '+', e.g. eng+rus. Must be installed.
OCR_LANGUAGES=eng
# Only if tesseract is not on PATH (Windows), e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OpenAI. Model is configurable; default is the cheapest model listed on the official models page.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- docker compose only ---
# Tesseract language packs baked into the image at build time (space separated, e.g. 'eng rus').
# OCR_LANGUAGES must only use installed packs.
TESSERACT_LANGS=eng
API_PORT=8000
# Serve /docs and /openapi.json without an API key. Set false if exposed publicly.
ENABLE_DOCS=true
WEB_PORT=8080

# Refuse documents whose extracted text is longer than this many characters (instead of truncating).
MAX_LLM_INPUT_CHARS=40000
